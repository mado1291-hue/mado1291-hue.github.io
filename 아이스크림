<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>무지개 아이스크림 가게 - 배달 놀이</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Playful & Cute Font (Jua) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Tone.js for Sound Effects -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <style>
        body {
            font-family: 'Jua', sans-serif;
            background-color: #fff3f8;
            user-select: none;
        }
        /* Custom scrollbar for ice cream feel */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #ffe3f0;
        }
        ::-webkit-scrollbar-thumb {
            background: #ffb6c1;
            border-radius: 9999px;
        }
        /* Bouncy animations */
        .bounce-hover:hover {
            transform: scale(1.05);
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .active-tab {
            background-color: #ff69b4 !important;
            color: white !important;
            box-shadow: 0 4px 14px rgba(255, 105, 180, 0.4);
        }
        /* Sweet cloud animation */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        .floating-cloud {
            animation: float 4s ease-in-out infinite;
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col pb-8">

    <!-- TOP NAVIGATION & STATUS BAR -->
    <header class="bg-white/90 backdrop-blur-md sticky top-0 z-50 shadow-sm border-b-4 border-pink-200 px-4 py-3">
        <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
            <!-- Brand Logo -->
            <div class="flex items-center gap-2">
                <span class="text-3xl">🌈</span>
                <div>
                    <h1 class="text-2xl font-bold text-pink-500 tracking-wider">무지개 아이스크림 가게</h1>
                    <p class="text-xs text-slate-400 font-sans">아이스크림 가게 배달 놀이 딜리버리 앱</p>
                </div>
            </div>

            <!-- Role Selector & Status Coins -->
            <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
                <!-- Sound Toggle -->
                <button id="soundBtn" onclick="toggleSound()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 rounded-full transition text-sm flex items-center gap-1">
                    <i id="soundIcon" class="fas fa-volume-up text-pink-500"></i>
                    <span>소리 켬</span>
                </button>

                <!-- Coin Counter -->
                <div class="flex items-center gap-1.5 bg-amber-100 border-2 border-amber-300 text-amber-700 font-bold px-3 py-1.5 rounded-full shadow-inner">
                    <span class="text-lg">🪙</span>
                    <span id="coinCount">100</span>
                    <span class="text-xs">코인</span>
                </div>
            </div>
        </div>
        
        <!-- Role Switching Tabs -->
        <div class="max-w-md mx-auto mt-3 grid grid-cols-2 gap-2 bg-pink-100 p-1 rounded-2xl">
            <button id="customerTab" onclick="switchRole('customer')" class="active-tab py-2.5 rounded-xl font-bold transition-all text-center flex items-center justify-center gap-2">
                <span>🛍️</span> 손님 주문하기
            </button>
            <button id="ownerTab" onclick="switchRole('owner')" class="text-pink-600 hover:bg-white/50 py-2.5 rounded-xl font-bold transition-all text-center flex items-center justify-center gap-2 relative">
                <span>👩‍🍳</span> 사장님 주방
                <!-- Notification Badge -->
                <span id="orderBadge" class="hidden absolute -top-1.5 -right-1.5 bg-red-500 text-white text-xs w-5.5 h-5.5 flex items-center justify-center rounded-full border-2 border-white animate-bounce">0</span>
            </button>
        </div>
    </header>

    <!-- MAIN CONTENT WRAPPER -->
    <main class="flex-grow max-w-4xl w-full mx-auto px-4 mt-6">
        
        <!-- Toast Notification Container -->
        <div id="toastContainer" class="fixed top-24 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none"></div>

        <!-- ============================================== -->
        <!-- 1. CUSTOMER MODE (손님 주문 화면) -->
        <!-- ============================================== -->
        <section id="customerView" class="space-y-6 block">
            <!-- Ice Cream Builder Grid -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                
                <!-- Left: Interactive Ice Cream Realtime Preview -->
                <div class="md:col-span-5 flex flex-col items-center justify-center bg-white p-6 rounded-3xl shadow-md border-4 border-pink-100 relative overflow-hidden min-h-[350px]">
                    <div class="absolute top-2 left-2 text-xs bg-pink-100 text-pink-600 px-3 py-1 rounded-full">실시간 미리보기 🍦</div>
                    
                    <!-- Sound Hint Cloud -->
                    <div class="absolute right-4 top-4 bg-slate-50 border border-slate-100 rounded-xl px-2 py-1 text-[10px] text-slate-400 floating-cloud hidden md:block">
                        옵션을 클릭하면 소리가 나요! ✨
                    </div>

                    <!-- Dynamic SVG Ice Cream Container -->
                    <div id="iceCreamPreview" class="w-full max-w-[200px] h-[250px] flex items-center justify-center">
                        <!-- SVG dynamically populated by JS -->
                    </div>

                    <!-- Order Summary Bubble -->
                    <div class="mt-4 text-center">
                        <p id="summaryText" class="text-sm text-slate-500 font-sans">원하는 조합을 아래에서 클릭해보세요!</p>
                        <p id="summaryFlavors" class="text-base text-pink-600 font-bold mt-1"></p>
                    </div>
                </div>

                <!-- Right: Customizer Control Panel -->
                <div class="md:col-span-7 bg-white p-6 rounded-3xl shadow-md border-4 border-pink-100 space-y-6">
                    <h3 class="text-xl font-bold text-slate-700 flex items-center gap-2 border-b-2 border-pink-50 pb-2">
                        <span class="text-pink-500">🎨</span> 나만의 아이스크림 만들기
                    </h3>

                    <!-- STEP 1: Choose Base Container (Pink Cup & Wooden Bar) -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-slate-500">1단계: 담을 그릇 고르기</label>
                        <div class="grid grid-cols-2 gap-4">
                            <button onclick="setBase('cup')" id="base-cup" class="base-btn border-2 border-pink-400 p-3 rounded-2xl flex flex-col items-center gap-1.5 transition bg-pink-50/50">
                                <span class="text-3xl">🍧</span>
                                <span class="text-sm font-bold">핑크컵</span>
                            </button>
                            <button onclick="setBase('bar')" id="base-bar" class="base-btn border-2 border-slate-200 hover:border-pink-300 p-3 rounded-2xl flex flex-col items-center gap-1.5 transition bg-slate-50">
                                <span class="text-3xl">🍭</span>
                                <span class="text-sm font-bold">달콤바 (막대)</span>
                            </button>
                        </div>
                    </div>

                    <!-- STEP 2: Dynamic Ice Cream Flavors -->
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <label id="flavorStepTitle" class="block text-sm font-semibold text-slate-500">2단계: 아이스크림 맛</label>
                            <button onclick="clearScoops()" class="text-xs text-red-400 hover:text-red-500 hover:underline">
                                <i class="fas fa-trash-alt mr-1"></i>다시 고르기
                            </button>
                        </div>
                        
                        <!-- Flavor Buttons Container (Dynamically swapped by JS based on Base selection) -->
                        <div id="flavorButtonsGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <!-- Populated dynamically -->
                        </div>
                    </div>

                    <!-- STEP 3: Choose Toppings -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-slate-500">3단계: 맛있는 토핑 얹기 (중복 가능)</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <button onclick="toggleTopping('cherry')" id="top-cherry" class="topping-btn border border-slate-200 p-2 rounded-xl flex items-center justify-center gap-1.5 hover:bg-red-50 active:scale-95 transition">
                                <span>🍒</span>
                                <span class="text-xs font-bold">체리</span>
                            </button>
                            <button onclick="toggleTopping('sprinkle')" id="top-sprinkle" class="topping-btn border border-slate-200 p-2 rounded-xl flex items-center justify-center gap-1.5 hover:bg-amber-50 active:scale-95 transition">
                                <span>✨</span>
                                <span class="text-xs font-bold">가루 가루</span>
                            </button>
                            <button onclick="toggleTopping('syrup')" id="top-syrup" class="topping-btn border border-slate-200 p-2 rounded-xl flex items-center justify-center gap-1.5 hover:bg-amber-100 hover:border-amber-600 active:scale-95 transition">
                                <span>🍫</span>
                                <span class="text-xs font-bold">초코시럽</span>
                            </button>
                            <button onclick="toggleTopping('cookie')" id="top-cookie" class="topping-btn border border-slate-200 p-2 rounded-xl flex items-center justify-center gap-1.5 hover:bg-slate-100 active:scale-95 transition">
                                <span>🍪</span>
                                <span class="text-xs font-bold">쿠키칩</span>
                            </button>
                        </div>
                    </div>

                    <!-- STEP 4: Delivery Form & Submit -->
                    <div class="bg-pink-50/50 p-4 rounded-2xl border-2 border-pink-100 space-y-3">
                        <h4 class="font-bold text-pink-600 text-sm flex items-center gap-1.5">
                            <i class="fas fa-motorcycle"></i> 배송 정보를 적어주세요!
                        </h4>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
                            <div>
                                <label class="block text-xs text-slate-500 mb-1">우리집 이름 (또는 방 이름)</label>
                                <input type="text" id="custName" value="안방 소파" class="w-full px-3 py-2 rounded-xl border border-pink-200 focus:outline-none focus:ring-2 focus:ring-pink-300 font-sans" placeholder="예: 공주방, 거실 소파">
                            </div>
                            <div>
                                <label class="block text-xs text-slate-500 mb-1">손님 이름</label>
                                <input type="text" id="custAlias" value="귀여운 다람쥐" class="w-full px-3 py-2 rounded-xl border border-pink-200 focus:outline-none focus:ring-2 focus:ring-pink-300 font-sans" placeholder="예: 지우 공주님, 아빠">
                            </div>
                        </div>
                        <button onclick="submitOrder()" class="w-full bg-gradient-to-r from-pink-500 to-rose-400 hover:from-pink-600 hover:to-rose-500 text-white font-bold py-3 px-4 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform active:scale-[0.98] flex items-center justify-center gap-2 text-lg mt-2">
                            <span>🚀</span> 맛있는 아이스크림 배달 주문하기!
                        </button>
                    </div>

                </div>
            </div>

            <!-- REAL-TIME TRACKING SECTION FOR CUSTOMER -->
            <div class="bg-white p-6 rounded-3xl shadow-md border-4 border-pink-100 space-y-4">
                <h3 class="text-xl font-bold text-slate-700 flex items-center gap-2 border-b-2 border-slate-100 pb-2">
                    <span class="text-cyan-500">🛵</span> 내가 주문한 배달 현황판
                </h3>

                <div id="trackingList" class="space-y-4">
                    <div class="text-center py-8 text-slate-400 font-sans">
                        <span class="text-4xl block mb-2">🍽️</span>
                        아직 주문한 아이스크림이 없습니다.<br>위에서 나만의 아이스크림을 만들어 주문해보세요!
                    </div>
                </div>
            </div>
        </section>

        <!-- ============================================== -->
        <!-- 2. OWNER/KITCHEN MODE (사장님 조립 주방 화면) -->
        <!-- ============================================== -->
        <section id="ownerView" class="space-y-6 hidden">
            <!-- Owner Control Board -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                
                <!-- Left: Incoming Order Queue -->
                <div class="md:col-span-5 bg-white p-5 rounded-3xl shadow-md border-4 border-indigo-100 flex flex-col min-h-[400px]">
                    <h3 class="text-xl font-bold text-slate-700 flex items-center justify-between border-b-2 border-slate-100 pb-2 mb-3">
                        <span class="flex items-center gap-2">
                            <span class="text-indigo-500">📥</span> 대기중인 주문서
                        </span>
                        <span id="orderQueueCount" class="bg-indigo-500 text-white text-sm px-2.5 py-0.5 rounded-full font-sans">0개</span>
                    </h3>

                    <!-- Order Queue Container -->
                    <div id="orderQueue" class="space-y-3 overflow-y-auto flex-grow max-h-[350px] pr-1 font-sans">
                        <div class="text-center py-12 text-slate-400">
                            <span class="text-4xl block mb-2">💤</span>
                            새로 들어온 주문이 없습니다.<br>손님 모드에서 먼저 주문해 보세요!
                        </div>
                    </div>
                </div>

                <!-- Right: Assembly Counter (Making the Ice cream) -->
                <div class="md:col-span-7 bg-white p-6 rounded-3xl shadow-md border-4 border-indigo-100 space-y-5 flex flex-col">
                    <h3 class="text-xl font-bold text-slate-700 flex items-center gap-2 border-b-2 border-indigo-50 pb-2">
                        <span class="text-amber-500">🍳</span> 아이스크림 제작 매대
                    </h3>

                    <div id="noActiveAssembly" class="flex-grow flex flex-col items-center justify-center text-center py-12 text-slate-400">
                        <span class="text-5xl block mb-3">🧑‍🍳</span>
                        <p class="font-bold text-slate-600">제작할 주문서를 왼쪽에서 골라주세요!</p>
                        <p class="text-xs mt-1 font-sans">선택한 주문서의 레시피대로 맛있게 만들어 배달할 수 있습니다.</p>
                    </div>

                    <!-- ACTIVE ASSEMBLY TABLE -->
                    <div id="activeAssemblyArea" class="hidden flex-grow space-y-4">
                        <!-- Recipe Card -->
                        <div class="bg-indigo-50 border-2 border-indigo-200 p-4 rounded-2xl flex items-start gap-3 relative">
                            <span class="text-3xl">📝</span>
                            <div class="font-sans">
                                <span class="bg-indigo-600 text-white text-xs px-2 py-0.5 rounded font-bold">레시피 확인</span>
                                <div class="font-bold text-slate-700 text-base mt-1" id="recipeTargetDesc"></div>
                                <div class="text-xs text-indigo-700 mt-0.5 font-bold" id="recipeTargetDetails"></div>
                            </div>
                        </div>

                        <!-- Side by Side Workspace -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Left Side: Creator Realtime Canvas -->
                            <div class="border-2 border-dashed border-slate-200 rounded-2xl p-4 flex flex-col items-center justify-center bg-slate-50 min-h-[220px]">
                                <span class="text-xs text-slate-400 mb-2 font-sans font-bold">나의 조립 상태</span>
                                <div id="ownerAssemblyPreview" class="w-36 h-36 flex items-center justify-center"></div>
                                <div id="ownerAssemblyStatus" class="text-xs font-bold text-slate-500 mt-2 font-sans text-center">그릇을 선택해주세요</div>
                            </div>

                            <!-- Right Side: Kitchen Chef Tools -->
                            <div class="space-y-4">
                                <!-- Tool 1: Base -->
                                <div>
                                    <span class="text-xs text-slate-500 font-bold block mb-1">1. 그릇 담기</span>
                                    <div class="grid grid-cols-2 gap-2">
                                        <button onclick="chefSetBase('cup')" class="chef-base-btn border border-slate-300 py-1.5 rounded-lg text-xs font-bold bg-white hover:bg-indigo-50 active:scale-95 transition">핑크컵</button>
                                        <button onclick="chefSetBase('bar')" class="chef-base-btn border border-slate-300 py-1.5 rounded-lg text-xs font-bold bg-white hover:bg-indigo-50 active:scale-95 transition">달콤바</button>
                                    </div>
                                </div>

                                <!-- Tool 2: Scoops / Bars -->
                                <div>
                                    <div class="flex justify-between items-center mb-1">
                                        <span id="chefFlavorTitle" class="text-xs text-slate-500 font-bold block">2. 맛 선택하기</span>
                                        <button onclick="chefClearScoops()" class="text-[10px] text-red-500 hover:underline">비우기</button>
                                    </div>
                                    <!-- Dynamic Chef flavor buttons based on current active recipe -->
                                    <div id="chefFlavorGrid" class="grid grid-cols-2 gap-1.5">
                                        <!-- Loaded Dynamically via JS -->
                                    </div>
                                </div>

                                <!-- Tool 3: Toppings -->
                                <div>
                                    <span class="text-xs text-slate-500 font-bold block mb-1">3. 토핑 올리기</span>
                                    <div class="grid grid-cols-2 gap-1.5">
                                        <button id="chef-top-cherry" onclick="chefToggleTopping('cherry')" class="chef-top-btn border border-slate-300 py-1 rounded-lg text-[10px] font-bold bg-white active:scale-95 transition">🍒 체리</button>
                                        <button id="chef-top-sprinkle" onclick="chefToggleTopping('sprinkle')" class="chef-top-btn border border-slate-300 py-1 rounded-lg text-[10px] font-bold bg-white active:scale-95 transition">✨ 가루</button>
                                        <button id="chef-top-syrup" onclick="chefToggleTopping('syrup')" class="chef-top-btn border border-slate-300 py-1 rounded-lg text-[10px] font-bold bg-white active:scale-95 transition">🍫 시럽</button>
                                        <button id="chef-top-cookie" onclick="chefToggleTopping('cookie')" class="chef-top-btn border border-slate-300 py-1 rounded-lg text-[10px] font-bold bg-white active:scale-95 transition">🍪 쿠키</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Complete and Deliver Button -->
                        <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row gap-2">
                            <button onclick="abandonChefOrder()" class="px-4 py-2 text-slate-400 hover:text-slate-600 font-sans text-sm font-bold border border-slate-200 hover:bg-slate-50 rounded-xl transition">
                                만들기 취소
                            </button>
                            <button id="shipOrderBtn" onclick="shipActiveOrder()" class="flex-grow bg-slate-200 text-slate-400 cursor-not-allowed font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 text-base transition duration-300">
                                <span>📦</span> 주문 레시피대로 맛있게 만들어주세요!
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </main>

    <!-- ============================================== -->
    <!-- MODAL: KIDS DRAWING BOOK (꼬마 예술가 그림판 모달) -->
    <!-- ============================================== -->
    <div id="drawingModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl border-4 border-pink-300 overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="bg-pink-100 p-4 border-b-2 border-pink-200 flex justify-between items-center flex-shrink-0">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">🎨</span>
                    <div>
                        <h3 class="text-lg font-bold text-pink-600">꼬마 예술가의 스케치북</h3>
                        <p class="text-[10px] text-slate-500 font-sans">손가락으로 그리거나 내 그림 사진을 올려보세요!</p>
                    </div>
                </div>
                <button onclick="closeDrawingModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
            </div>
            
            <!-- Drawing Area -->
            <div class="p-5 flex-grow overflow-y-auto space-y-4 flex flex-col items-center">
                <!-- Canvas Container -->
                <div class="relative bg-pink-50/50 border-4 border-dashed border-pink-200 rounded-2xl overflow-hidden w-[260px] h-[260px] shadow-inner flex items-center justify-center">
                    <canvas id="kidsCanvas" width="250" height="250" class="bg-white rounded-lg cursor-crosshair touch-none"></canvas>
                </div>

                <!-- Palette Tools -->
                <div class="w-full">
                    <span class="text-xs text-slate-500 font-bold block mb-2 text-center">🖌️ 원하는 색깔 물감을 골라요!</span>
                    <div class="grid grid-cols-6 gap-2 justify-center">
                        <button onclick="changeBrushColor('#FF1744')" class="color-dot w-9 h-9 rounded-full bg-[#FF1744] border-2 border-white ring-2 ring-transparent transition hover:scale-110 active:scale-95" title="딸기빨강"></button>
                        <button onclick="changeBrushColor('#FFEB3B')" class="color-dot w-9 h-9 rounded-full bg-[#FFEB3B] border-2 border-white ring-2 ring-transparent transition hover:scale-110 active:scale-95" title="바나나노랑"></button>
                        <button onclick="changeBrushColor('#4CAF50')" class="color-dot w-9 h-9 rounded-full bg-[#4CAF50] border-2 border-white ring-2 ring-transparent transition hover:scale-110 active:scale-95" title="메론초록"></button>
                        <button onclick="changeBrushColor('#2196F3')" class="color-dot w-9 h-9 rounded-full bg-[#2196F3] border-2 border-white ring-2 ring-transparent transition hover:scale-110 active:scale-95" title="하늘블루"></button>
                        <button onclick="changeBrushColor('#9C27B0')" class="color-dot w-9 h-9 rounded-full bg-[#9C27B0] border-2 border-white ring-2 ring-transparent transition hover:scale-110 active:scale-95" title="포도보라"></button>
                        <button onclick="changeBrushColor('#4E342E')" class="color-dot w-9 h-9 rounded-full bg-[#4E342E] border-2 border-white ring-2 ring-transparent transition hover:scale-110 active:scale-95" title="초코브라운"></button>
                    </div>
                </div>

                <!-- Brush Size & Utility buttons -->
                <div class="w-full flex justify-between gap-2 items-center text-xs">
