    <!-- JAVASCRIPT LOGIC -->
    <script>
        /**************************************************************
         * SOUND & FX ENGINE (Tone.js wrapper)
         **************************************************************/
        let soundEnabled = true;
        let synth = null;
        let drumSynth = null;

        // Initialize Tone.js Synths on first user interaction
        function initAudio() {
            if (!synth) {
                synth = new Tone.PolySynth(Tone.Synth, {
                    oscillator: { type: "sine" },
                    envelope: { attack: 0.05, decay: 0.1, sustain: 0.3, release: 0.5 }
                }).toDestination();
                synth.volume.value = -8;

                drumSynth = new Tone.MetalSynth({
                    frequency: 200,
                    envelope: { attack: 0.001, decay: 0.05, release: 0.05 },
                    harmonicity: 5.1,
                    modulationIndex: 32,
                    resonance: 4000,
                    octaves: 1.5
                }).toDestination();
                drumSynth.volume.value = -12;
            }
        }

        function playSuccessSound() {
            if (!soundEnabled) return;
            initAudio();
            const now = Tone.now();
            synth.triggerAttackRelease("C5", "8n", now);
            synth.triggerAttackRelease("E5", "8n", now + 0.12);
            synth.triggerAttackRelease("G5", "8n", now + 0.24);
            synth.triggerAttackRelease("C6", "4n", now + 0.36);
        }

        function playScoopSound() {
            if (!soundEnabled) return;
            initAudio();
            const now = Tone.now();
            synth.triggerAttackRelease("G4", "16n", now);
            synth.triggerAttackRelease("C5", "8n", now + 0.05);
        }

        function playSprinkleSound() {
            if (!soundEnabled) return;
            initAudio();
            const now = Tone.now();
            drumSynth.triggerAttackRelease("16n", now);
            setTimeout(() => { if(soundEnabled) drumSynth.triggerAttackRelease("16n"); }, 80);
            setTimeout(() => { if(soundEnabled) drumSynth.triggerAttackRelease("16n"); }, 160);
        }

        function playEngineSound() {
            if (!soundEnabled) return;
            initAudio();
            const now = Tone.now();
            synth.triggerAttackRelease("A3", "16n", now);
            synth.triggerAttackRelease("C4", "16n", now + 0.1);
            synth.triggerAttackRelease("E4", "16n", now + 0.2);
            synth.triggerAttackRelease("G4", "8n", now + 0.3);
            synth.triggerAttackRelease("C5", "4n", now + 0.4);
        }

        function playBellSound() {
            if (!soundEnabled) return;
            initAudio();
            const now = Tone.now();
            synth.triggerAttackRelease("E6", "8n", now);
            synth.triggerAttackRelease("C6", "4n", now + 0.15);
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById("soundIcon");
            const btnText = document.querySelector("#soundBtn span");
            if (soundEnabled) {
                icon.className = "fas fa-volume-up text-pink-500";
                btnText.innerText = "소리 켬";
                initAudio();
                playScoopSound();
            } else {
                icon.className = "fas fa-volume-mute text-slate-400";
                btnText.innerText = "소리 끔";
            }
        }

