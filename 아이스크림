        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    kidsCtx.clearRect(0, 0, kidsCanvas.width, kidsCanvas.height);
                    // Draw image scaled to fit canvas proportionally
                    const scale = Math.min(kidsCanvas.width / img.width, kidsCanvas.height / img.height);
                    const x = (kidsCanvas.width / 2) - (img.width / 2) * scale;
                    const y = (kidsCanvas.height / 2) - (img.height / 2) * scale;
                    kidsCtx.drawImage(img, x, y, img.width * scale, img.height * scale);
                    playSuccessSound();
                    showToast("📸 사진 업로드 성공! 막대 아이스크림 옷을 입혔어요.", "success");
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

