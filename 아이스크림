            const targetOrder = state.orders.find(o => o.id === state.chef.activeOrderId);
            if (!targetOrder) return;

            const isCustomDrawingOrder = targetOrder.scoops.includes('kids_draw');

            // Target Recipe Setup
            const targetBaseTxt = BASE_NAMES[targetOrder.base];
            let targetFlavorsTxt = targetOrder.scoops.map(f => FLAVOR_NAMES[f]).join(" -> ");
            const targetToppingsTxt = targetOrder.toppings.map(t => TOPPING_NAMES[t]).join(", ") || "토핑 없음";

            document.getElementById("recipeTargetDesc").innerText = `[${targetOrder.customerName}] 님의 주문 레시피`;
            
            if (isCustomDrawingOrder) {
                document.getElementById("recipeTargetDetails").innerHTML = `
                    <div class="text-pink-600 font-bold text-xs bg-pink-50 p-2 rounded-lg border border-pink-200 mt-1">
                        🎨 세상에 하나뿐인 꼬마 작가님의 커스텀 막대기 아이스크림 주문입니다! <br>
                        주방에서는 <strong class="underline">"달콤바" 그릇을 고르고 "🎨 내그림"을 선택한 뒤, 토핑 [${targetToppingsTxt}]</strong>을 올리면 완벽 조립 완료!
                    </div>
                `;
            } else {
                document.getElementById("recipeTargetDetails").innerText = `그릇: ${targetBaseTxt} | 구성 맛: ${targetFlavorsTxt} | 토핑: ${targetToppingsTxt}`;
            }

            // Render Chef Workspace Interactive Preview SVG
            document.getElementById("ownerAssemblyPreview").innerHTML = makeIceCreamSVG(
                state.chef.base,
                state.chef.scoops,
                state.chef.toppings,
                targetOrder.customDrawingData // Pass child's picture context into preview!
            );

            // Highlight Chef Container Buttons
            document.querySelectorAll(".chef-base-btn").forEach(btn => {
                btn.classList.remove("bg-indigo-600", "text-white", "border-indigo-600");
                btn.classList.add("bg-white", "text-slate-800");
            });
            if (state.chef.base) {
                const matchBtn = Array.from(document.querySelectorAll(".chef-base-btn")).find(el => el.textContent.includes(BASE_NAMES[state.chef.base]));
                if (matchBtn) {
                    matchBtn.classList.add("bg-indigo-600", "text-white", "border-indigo-600");
                    matchBtn.classList.remove("bg-white", "text-slate-800");
                }
            }

            // Dynamically Render Chef Taste/Scoop Panel Buttons based on Chef's selected base container
            const chefFlavorGrid = document.getElementById("chefFlavorGrid");
            const chefFlavorTitle = document.getElementById("chefFlavorTitle");
            chefFlavorGrid.innerHTML = ''; // reset

            if (state.chef.base) {
                chefFlavorTitle.innerText = state.chef.base === 'bar' 
                    ? "2. 맛있는 막대바 고르기 (택 1)" 
                    : "2. 아이스크림 스쿱 고르기 (택 1)";

                const activeFlavorsList = FLAVORS_BY_BASE[state.chef.base];
                activeFlavorsList.forEach(flavor => {
                    const isSelected = state.chef.scoops.includes(flavor.id);
                    const selectedClass = isSelected ? 'ring-2 ring-indigo-600 scale-105 border-indigo-600' : 'border-slate-200';
                    
                    let itemText = flavor.name;
                    if (flavor.id === 'kids_draw') {
                        itemText = isCustomDrawingOrder ? "🎨 손님 그림바" : "🎨 그림 (손님전용)";
                    }

                    // Disable kids draw button in kitchen IF this wasn't a kids draw order, to avoid confusion
                    const isDisabled = flavor.id === 'kids_draw' && !isCustomDrawingOrder;
                    const opacityClass = isDisabled ? 'opacity-30 cursor-not-allowed' : '';

                    chefFlavorGrid.innerHTML += `
                        <button ${isDisabled ? 'disabled' : ''} onclick="chefAddScoop('${flavor.id}')" class="border py-1.5 rounded-lg text-[10px] font-bold active:scale-95 transition bg-white ${selectedClass} ${opacityClass}">
                            ${flavor.id === 'kids_draw' ? '🖼️' : flavor.emoji || '🍦'} ${itemText}
                        </button>
                    `;
                });
            } else {
                chefFlavorTitle.innerText = "2. 맛 선택하기 (1단계를 먼저 선택하세요)";
                chefFlavorGrid.innerHTML = `
                    <div class="col-span-2 text-center text-[10px] text-slate-400 py-3">그릇을 선택하시면 전용 맛들이 여기에 나타납니다!</div>
                `;
            }

            // Highlight Active Toppings in Kitchen
            document.querySelectorAll(".chef-top-btn").forEach(btn => {
                btn.classList.remove("bg-indigo-100", "border-indigo-400");
            });
            state.chef.toppings.forEach(top => {
                const btn = document.getElementById(`chef-top-${top}`);
                if (btn) btn.classList.add("bg-indigo-100", "border-indigo-400");
            });

            // Match Validation Process
            const statusLabel = document.getElementById("ownerAssemblyStatus");
            const shipBtn = document.getElementById("shipOrderBtn");

            const baseMatches = state.chef.base === targetOrder.base;
            const scoopsMatch = state.chef.scoops.length === targetOrder.scoops.length && 
                               state.chef.scoops.every((val, index) => val === targetOrder.scoops[index]);
            const toppingsMatch = arraysEqual(state.chef.toppings, targetOrder.toppings);

            if (baseMatches && scoopsMatch && toppingsMatch) {
                statusLabel.innerHTML = `<span class="text-emerald-500 font-bold">✨ 완벽해요! 주문서 레시피와 일치합니다!</span>`;
                shipBtn.className = "flex-grow bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-bold py-3 px-4 rounded-xl shadow-lg transition duration-300 transform active:scale-95 flex items-center justify-center gap-2 text-base cursor-pointer";
                shipBtn.innerHTML = `<span>🛵</span> 포장 완료! 배달 출발하기!!`;
                shipBtn.disabled = false;
            } else {
                let errorHint = "조립 중: ";
                if (!baseMatches) errorHint += "그릇 종류가 일치하지 않습니다. ";
                else if (!scoopsMatch) {
                    errorHint += isCustomDrawingOrder ? "막대바로 '🎨 손님 그림바'를 올려주세요. " : "주문서의 맛 구성과 순서를 맞춰주세요. ";
                }
                else if (!toppingsMatch) errorHint += "주문한 토핑들을 알맞게 올려주세요. ";

                statusLabel.innerHTML = `<span class="text-red-400 font-bold">${errorHint}</span>`;
                shipBtn.className = "flex-grow bg-slate-200 text-slate-400 font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 text-base cursor-not-allowed";
                shipBtn.innerHTML = `<span>📦</span> 레시피가 일치하지 않습니다`;
                shipBtn.disabled = true;
            }
        }

        // SHIP ORDER TO DESTINATION
        function shipActiveOrder() {
            const targetOrder = state.orders.find(o => o.id === state.chef.activeOrderId);
            if (!targetOrder) return;

            playEngineSound();

            targetOrder.status = 'delivering';
            showToast(`🛵 [${targetOrder.customerName}] 님 배송지로 오토바이 전력 질주 출발!`, "info");

            const deliveredOrderId = state.chef.activeOrderId;

            // Reset workspace details
            state.chef.activeOrderId = null;
            state.chef.base = null;
            state.chef.scoops = [];
            state.chef.toppings = [];

            updateCustomerTracker();
            updateOwnerOrderBadge();
            renderOwnerKitchen();

            // Travel simulation delay
            setTimeout(() => {
                const dOrder = state.orders.find(o => o.id === deliveredOrderId);
                if (dOrder) {
                    dOrder.status = 'delivered';
                    playBellSound();
                    showToast(`🏠 오토바이가 [${dOrder.address}]에 도착해 배달을 완료했어요!`, "success");
                    updateCustomerTracker();
                    renderOwnerKitchen();
                }
            }, 4000);
        }

        /**************************************************************
         * INITIAL LOADING CONTROL
         **************************************************************/
        window.onload = function() {
            renderCustomerControls();
            updateCustomerTracker();
            updateOwnerOrderBadge();
            
            setTimeout(() => {
                showToast("🍦 무지개 아이스크림 가게 배달 놀이 앱에 오신것을 환영합니다! 🎉", "success");
            }, 500);
        };
    </script>
</body>
</html>
