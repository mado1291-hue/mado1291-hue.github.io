        /**************************************************************
         * STREAMING_CHUNK: Toast alert and generic state managers
         **************************************************************/
        function showToast(message, type = "success") {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = `px-5 py-3 rounded-2xl shadow-xl border-2 flex items-center gap-2 transform transition-all duration-300 translate-y-2 opacity-0 font-sans font-bold text-sm ${
                type === "success" 
                    ? "bg-emerald-50 border-emerald-300 text-emerald-800" 
                    : type === "info"
                    ? "bg-sky-50 border-sky-300 text-sky-800"
                    : "bg-pink-50 border-pink-300 text-pink-800"
            }`;
            toast.innerHTML = `<span>${type === 'success' ? '✨' : '🍦'}</span><span>${message}</span>`;
            
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.remove("translate-y-2", "opacity-0");
            }, 10);

            setTimeout(() => {
                toast.classList.add("translate-y-2", "opacity-0");
                setTimeout(() => {
                    toast.remove();
                }, 300);
            }, 3000);
        }

        function switchRole(role) {
            state.role = role;
            initAudio();

            const customerBtn = document.getElementById("customerTab");
            const ownerBtn = document.getElementById("ownerTab");
