        /**************************************************************
         * STREAMING_CHUNK: Integrating Canvas drawing & Touch/Mouse Event Listeners
         **************************************************************/
        // Canvas Variables
        let kidsCanvas, kidsCtx;
        let drawingState = {
            isDrawing: false,
            brushColor: '#FF1744',
            brushSize: 10
        };

        function openDrawingModal() {
            initAudio();
            document.getElementById("drawingModal").classList.remove("hidden");
            
            // Lazy Canvas Initialize
            if (!kidsCanvas) {
                kidsCanvas = document.getElementById("kidsCanvas");
                kidsCtx = kidsCanvas.getContext("2d", { willReadFrequently: true });
                setupDrawingEvents();
            }
            
            // Set canvas background to semi-transparent white/alpha if empty
            if (!state.customer.customDrawingData) {
                clearKidsCanvas();
            }
        }

        function closeDrawingModal() {
            document.getElementById("drawingModal").classList.add("hidden");
        }

        function setupDrawingEvents() {
            // Helper coordinates
            const getPos = (e) => {
                const rect = kidsCanvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return {
                    x: clientX - rect.left,
                    y: clientY - rect.top
                };
            };

            const startDrawing = (e) => {
                drawingState.isDrawing = true;
                const pos = getPos(e);
                kidsCtx.beginPath();
                kidsCtx.moveTo(pos.x, pos.y);
                kidsCtx.lineWidth = drawingState.brushSize;
                kidsCtx.lineCap = 'round';
                kidsCtx.lineJoin = 'round';
                kidsCtx.strokeStyle = drawingState.brushColor;
                e.preventDefault();
            };

            const draw = (e) => {
                if (!drawingState.isDrawing) return;
                const pos = getPos(e);
                kidsCtx.lineTo(pos.x, pos.y);
                kidsCtx.stroke();
                e.preventDefault();
            };

            const stopDrawing = () => {
                drawingState.isDrawing = false;
                kidsCtx.closePath();
            };

            // Mouse Events
            kidsCanvas.addEventListener('mousedown', startDrawing);
            kidsCanvas.addEventListener('mousemove', draw);
            kidsCanvas.addEventListener('mouseup', stopDrawing);
            kidsCanvas.addEventListener('mouseleave', stopDrawing);

            // Touch Events (Perfect tablet compatibility)
            kidsCanvas.addEventListener('touchstart', startDrawing);
            kidsCanvas.addEventListener('touchmove', draw);
            kidsCanvas.addEventListener('touchend', stopDrawing);
        }

        function changeBrushColor(color) {
            drawingState.brushColor = color;
            playScoopSound();
            
            // Highlight selected color circle
            document.querySelectorAll(".color-dot").forEach(btn => {
                btn.classList.remove("ring-pink-400", "scale-110");
            });
            event.target.classList.add("ring-pink-400", "scale-110");
        }

        function clearKidsCanvas() {
            if (!kidsCtx) return;
            kidsCtx.clearRect(0, 0, kidsCanvas.width, kidsCanvas.height);
            // Draw a cute light pink dotted bounding box inside canvas
            kidsCtx.fillStyle = "#ffffff";
            kidsCtx.fillRect(0, 0, kidsCanvas.width, kidsCanvas.height);
            playScoopSound();
        }

        function triggerImageUpload() {
